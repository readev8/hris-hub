const regenerate = () => {
    return new Promise((resolve, reject) => {
        $.ajax({
            url: `${site_url}/request/get`,
            type: 'GET',
            dataType: 'JSON',
            success: (res) => {
                resolve(res)
            },
            error: (err) => {
                reject()
                toast_error('Terjadi kesalahan')
            }
        })
    })
}